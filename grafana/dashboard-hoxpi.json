{
  "uid": "hoxpi",
  "title": "HoxPi Wärmepumpe",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperaturen",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_aussentemp_c",
          "legendFormat": "Außen",
          "refId": "A"
        },
        {
          "expr": "hoval_vorlauf_c",
          "legendFormat": "Vorlauf",
          "refId": "B"
        },
        {
          "expr": "hoval_ruecklauf_c",
          "legendFormat": "Rücklauf",
          "refId": "C"
        },
        {
          "expr": "hoval_raum_ist_c",
          "legendFormat": "Raum",
          "refId": "D"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Warmwasser",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_ww_ist_c",
          "legendFormat": "WW Ist",
          "refId": "A"
        },
        {
          "expr": "hoval_ww_soll_c",
          "legendFormat": "WW Soll (Basis)",
          "refId": "B"
        },
        {
          "expr": "hoval_ww_soll_c + hoval_offset_ww_k * (hoval_sg_status == bool 1)",
          "legendFormat": "WW Ziel bei SG-Vorzug",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Leistung",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_p_el_kw",
          "legendFormat": "elektrisch",
          "refId": "A"
        },
        {
          "expr": "hoval_p_th_kw",
          "legendFormat": "thermisch",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "COP",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_cop",
          "legendFormat": "COP aktuell",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Status (HK1 / HK2 / WW / Kühlventil)",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_hc1_status",
          "legendFormat": "HK1 (0=Aus 1=Heizen 9=Kühlen 26=SG)",
          "refId": "A"
        },
        {
          "expr": "hoval_hc2_status",
          "legendFormat": "HK2",
          "refId": "B"
        },
        {
          "expr": "hoval_ww_status",
          "legendFormat": "WW (1=Laden 8=Eco)",
          "refId": "C"
        },
        {
          "expr": "hoval_uka",
          "legendFormat": "Kühlventil UKA",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Smart Grid",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_sg_status",
          "legendFormat": "SG-Status (1=Vorzug)",
          "refId": "A"
        },
        {
          "expr": "hoval_offset_ww_k",
          "legendFormat": "Offset WW [K]",
          "refId": "B"
        },
        {
          "expr": "hoval_offset_hk1_k",
          "legendFormat": "Offset HK1 [K]",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tagesenergie elektrisch [kWh]",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(hoval_energie_el_mwh[24h]) * 1000",
          "legendFormat": "Strom WP / 24h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Zählerstände [MWh]",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_energie_el_mwh",
          "legendFormat": "Strom gesamt",
          "refId": "A"
        },
        {
          "expr": "hoval_waerme_heizen_mwh",
          "legendFormat": "Wärme Heizen",
          "refId": "B"
        },
        {
          "expr": "hoval_waerme_ww_mwh",
          "legendFormat": "Wärme WW",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Verdichter: Modulation & Leistungs-Sollwert [%]",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_modulation_pct",
          "legendFormat": "Modulation Ist",
          "refId": "A"
        },
        {
          "expr": "clamp_min(hoval_leistung_soll_aktiv_pct, 0)",
          "legendFormat": "Sollwert aktiv",
          "refId": "B"
        },
        {
          "expr": "clamp_min(hoval_leistung_soll_heizen_pct, 0)",
          "legendFormat": "Soll Heizen",
          "refId": "C"
        },
        {
          "expr": "clamp_min(hoval_leistung_soll_ww_pct, 0)",
          "legendFormat": "Soll Warmwasser",
          "refId": "D"
        },
        {
          "expr": "clamp_min(hoval_leistung_soll_kuehlen_pct, 0)",
          "legendFormat": "Soll Kühlen",
          "refId": "E"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WP-Hydraulik: Vorlauf / Rücklauf / Volumenstrom / Pumpe",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Volumenstrom"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "flowlpm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pumpe"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "hoval_wp_vorlauf_c",
          "legendFormat": "WP-Vorlauf",
          "refId": "A"
        },
        {
          "expr": "hoval_wp_ruecklauf_c",
          "legendFormat": "WP-Rücklauf",
          "refId": "B"
        },
        {
          "expr": "hoval_volumenstrom_lmin",
          "legendFormat": "Volumenstrom",
          "refId": "C"
        },
        {
          "expr": "hoval_wp_pumpe_pct",
          "legendFormat": "Pumpe",
          "refId": "D"
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "WEZ-Status (Wärmeerzeuger)",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Aus",
                  "index": 0
                },
                "1": {
                  "text": "Heizen",
                  "index": 1
                },
                "2": {
                  "text": "Kühlen",
                  "index": 2
                },
                "4": {
                  "text": "Warmwasser",
                  "index": 3
                },
                "16": {
                  "text": "Wiedereinschaltsperre",
                  "index": 4
                },
                "17": {
                  "text": "Status 17",
                  "index": 5
                },
                "51": {
                  "text": "Startvorbereitung",
                  "index": 6
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#555555",
                "value": null
              },
              {
                "color": "#F2495C",
                "value": 1
              },
              {
                "color": "#5794F2",
                "value": 2
              },
              {
                "color": "#FF9830",
                "value": 4
              },
              {
                "color": "#8F3BB8",
                "value": 16
              },
              {
                "color": "#B877D9",
                "value": 17
              },
              {
                "color": "#73BF69",
                "value": 51
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_wez_status",
          "legendFormat": "WEZ",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Fehlercode & Anforderung",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hoval_fehlercode",
          "legendFormat": "Fehlercode (255 = OK)",
          "refId": "A"
        },
        {
          "expr": "hoval_leistung_anforderung",
          "legendFormat": "Leistungsanforderung (Flag)",
          "refId": "B"
        },
        {
          "expr": "hoval_wp_detailstatus",
          "legendFormat": "WP-Detailstatus",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Wärmemenge pro Tag [kWh]",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(hoval_waerme_heizen_mwh[24h]) * 1000",
          "legendFormat": "Heizen",
          "refId": "A"
        },
        {
          "expr": "increase(hoval_waerme_ww_mwh[24h]) * 1000",
          "legendFormat": "Warmwasser",
          "refId": "B"
        },
        {
          "expr": "increase(hoval_waerme_kuehlen_mwh[24h]) * 1000",
          "legendFormat": "Kühlen",
          "refId": "C"
        },
        {
          "expr": "increase(hoval_energie_el_mwh[24h]) * 1000",
          "legendFormat": "elektrisch (Vergleich)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Betriebsstunden pro Tag [h]",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(hoval_betriebsstunden_heizen_h[24h])",
          "legendFormat": "Heizen",
          "refId": "A"
        },
        {
          "expr": "increase(hoval_betriebsstunden_ww_h[24h])",
          "legendFormat": "Warmwasser",
          "refId": "B"
        },
        {
          "expr": "increase(hoval_betriebsstunden_kuehlen_h[24h])",
          "legendFormat": "Kühlen",
          "refId": "C"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Verdichterstarts pro Tag & Zählerstand",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Schaltzyklen gesamt"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "increase(hoval_schaltzyklen[24h])",
          "legendFormat": "Starts / 24 h",
          "refId": "A"
        },
        {
          "expr": "hoval_schaltzyklen",
          "legendFormat": "Schaltzyklen gesamt",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Wohnraumlüftung (HomeVent)",
      "datasource": {
        "type": "prometheus",
        "uid": "hoxpi-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Temperatur Abluft"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "hoval_kwl_luefter_pct",
          "legendFormat": "Lüfter",
          "refId": "A"
        },
        {
          "expr": "hoval_kwl_feuchte_abluft_pct",
          "legendFormat": "Feuchte Abluft",
          "refId": "B"
        },
        {
          "expr": "hoval_kwl_temp_abluft_c",
          "legendFormat": "Temperatur Abluft",
          "refId": "C"
        },
        {
          "expr": "hoval_kwl_co2_pct < 200",
          "legendFormat": "CO₂ (Rohwert)",
          "refId": "D"
        }
      ]
    }
  ]
}
